# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# API_URL совпадает с APP_URL в монолите; оставлен для внешнего API/CDN.
API_URL=http://localhost:3000/api
APP_NAME=GraderUP

# ─── Database (PostgreSQL 14+) ──────────────────────────────────────────
DATABASE_URL=postgres://graderup:graderup@localhost:5432/graderup
# Только для интеграционных тестов (будет очищена!)
TEST_DATABASE_URL=postgres://graderup:graderup@localhost:5432/graderup_test

# ─── Sessions / security ────────────────────────────────────────────────
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=30
# Доверять X-Forwarded-For (только за своим reverse proxy!)
TRUST_PROXY=false

# ─── Payments ───────────────────────────────────────────────────────────
# mock | real
PAYMENT_PROVIDER=mock
# Секрет подписи webhook (HMAC-SHA256). openssl rand -hex 32
PAYMENT_SECRET=change-me-payment-webhook-secret
# Mock-провайдер запрещён в production, если явно не разрешить (для стендов)
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
# Реальный провайдер (заполнить при интеграции)
REAL_PAYMENT_API_URL=
REAL_PAYMENT_API_KEY=
REAL_PAYMENT_MERCHANT_ID=

# ─── Платёжные методы (метод включается, когда заданы его ключи) ─────
# Pally (карты/СБП): https://pally.info → магазин → API-токен и ID магазина.
# Result URL в настройках магазина: {APP_URL}/api/payments/webhook/pally
PALLY_API_TOKEN=
PALLY_SHOP_ID=
PALLY_API_URL=https://pal24.pro/api/v1
# AnyPay: ID проекта и секретный ключ. URL оповещений: {APP_URL}/api/payments/webhook/anypay
ANYPAY_MERCHANT_ID=
ANYPAY_SECRET_KEY=
# IP-адреса AnyPay через запятую (рекомендуется, см. их документацию)
ANYPAY_ALLOWED_IPS=
# xRocket Pay (RocketX, Telegram @xRocket → Rocket Pay → API). Webhook: {APP_URL}/api/payments/webhook/xrocket
XROCKET_API_KEY=
XROCKET_API_URL=https://pay.xrocket.tg
XROCKET_CURRENCY=USDT
# Сколько коинов (₽) стоит 1 единица валюты выше
XROCKET_COINS_PER_UNIT=95

# ─── Вывод скинов в Steam ──────────────────────────────────────────────
# mock — симуляция трейда (ТОЛЬКО разработка, в production выключена); none — вывод скинов недоступен.
# Для боевого вывода нужен провайдер трейдов (маркетплейс/боты), см. src/server/trades.
TRADE_PROVIDER=mock
ALLOW_MOCK_TRADES_IN_PRODUCTION=false

# ─── Steam (OpenID 2.0 + Web API) ───────────────────────────────────────
STEAM_AUTH_ENABLED=true
# Для Steam OpenID ключ не нужен; STEAM_API_KEY (https://steamcommunity.com/dev/apikey) нужен для ника и аватара
STEAM_CLIENT_ID=
STEAM_CLIENT_SECRET=
STEAM_API_KEY=

# ─── Market prices (CS2 skins) ─────────────────────────────────────────
# none | skinport | steam | mock  (overrides admin setting)
PRICE_PROVIDER=
PRICE_CURRENCY=RUB

# Публичная регистрация по email (по умолчанию выкл.: вход через Steam, email — для админов)
EMAIL_REGISTRATION_ENABLED=false

# ─── Features / compliance ──────────────────────────────────────────────
FEATURE_WITHDRAW=true
# Минимальный возраст (0 = проверка выключена)
MIN_AGE=18
# Коды стран ISO-3166 через запятую, для которых сервис закрыт
RESTRICTED_COUNTRIES=
# Заголовок, из которого брать страну (например cf-ipcountry за Cloudflare)
COUNTRY_HEADER=
KYC_PROVIDER=none
KYC_WITHDRAW_THRESHOLD=50000

# Каталог для загружаемых из админки картинок (кейсы/предметы)
UPLOAD_DIR=./uploads

# ─── Seed ───────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@graderup.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_PASSWORD=Demo12345!
