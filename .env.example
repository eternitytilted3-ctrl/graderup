# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# API_URL совпадает с APP_URL в монолите; оставлен для внешнего API/CDN.
API_URL=http://localhost:3000/api
APP_NAME=GraderUP

# ─── Database (PostgreSQL 14+) ──────────────────────────────────────────
DATABASE_URL=postgres://graderup:graderup@localhost:5432/graderup
# Только для интеграционных тестов (будет очищена!)
TEST_DATABASE_URL=postgres://graderup:graderup@localhost:5432/graderup_test

# ─── Sessions / security ────────────────────────────────────────────────
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_DAYS=30
# Доверять X-Forwarded-For (только за своим reverse proxy!)
TRUST_PROXY=false

# ─── Payments ───────────────────────────────────────────────────────────
# mock | real
PAYMENT_PROVIDER=mock
# Секрет подписи webhook (HMAC-SHA256). openssl rand -hex 32
PAYMENT_SECRET=change-me-payment-webhook-secret
# Mock-провайдер запрещён в production, если явно не разрешить (для стендов)
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION=false
# Реальный провайдер (заполнить при интеграции)
REAL_PAYMENT_API_URL=
REAL_PAYMENT_API_KEY=
REAL_PAYMENT_MERCHANT_ID=

# ─── Steam (OpenID 2.0 + Web API) ───────────────────────────────────────
STEAM_AUTH_ENABLED=false
# Для Steam OpenID достаточно realm/return URL; Web API key нужен для профиля
STEAM_CLIENT_ID=
STEAM_CLIENT_SECRET=
STEAM_API_KEY=

# ─── Features / compliance ──────────────────────────────────────────────
FEATURE_WITHDRAW=true
# Минимальный возраст (0 = проверка выключена)
MIN_AGE=18
# Коды стран ISO-3166 через запятую, для которых сервис закрыт
RESTRICTED_COUNTRIES=
# Заголовок, из которого брать страну (например cf-ipcountry за Cloudflare)
COUNTRY_HEADER=
KYC_PROVIDER=none
KYC_WITHDRAW_THRESHOLD=500

# ─── Seed ───────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@graderup.local
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_PASSWORD=Demo12345!
